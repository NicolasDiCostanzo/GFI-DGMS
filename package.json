{
  "name": "gfi-dgms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GFI-DGMS Web Component",
  "main": "./dist/gfi-dgms.es.js",
  "module": "./dist/gfi-dgms.es.js",
  "exports": {
    ".": {
      "import": "./dist/gfi-dgms.es.js",
      "require": "./dist/gfi-dgms.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .vue,.ts",
    "format": "prettier --write \"src/**/*.{vue,ts}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts}\"",
    "depcruise": "depcruise --ts-config tsconfig.json --include-only \"^src\" src",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run depcruise",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "axe-playwright": "^2.2.2",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.11.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
